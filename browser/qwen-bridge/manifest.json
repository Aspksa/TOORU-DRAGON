{
  "manifest_version": 3,
  "name": "TOORU · DRAGON — Qwen Bridge",
  "version": "0.0.1",
  "description": "Локальный мост между отдельным профилем Qwen и TOORU · DRAGON.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
